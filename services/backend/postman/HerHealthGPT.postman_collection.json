            "url": {
              "raw": "{{baseUrl}}/triage/turn",
              "host": ["{{baseUrl}}"],
              "path": ["triage", "turn"]
            },
            "description": "Run 'Sign in' first. A well-formed but nonexistent session_id — reads identically to one that exists but belongs to someone else, so neither response confirms which (same discipline issue #13 established for its own conversations)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
