{
  "info": {
    "name": "HerHealthGPT backend",
    "description": "Manual API testing for the HerHealthGPT backend.\n\nImport this collection and the `HerHealthGPT — local` environment, start the API with `make db-up && make migrate && make serve`, then send the requests. `baseUrl` comes from the environment so the same requests work against staging later.\n\nAs the Accounts endpoints land (register, verify, sign in, …) add them as folders here; the health check is the skeleton.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Liveness of the service and its database.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns 200 with {\"status\":\"ok\"} when the service can reach PostgreSQL, and 503 with {\"status\":\"unavailable\"} when it cannot. The check performs a real database round-trip, so a 503 means the database, not just the process, is the problem."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('body reports ok', function () {",
                  "    pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Registering",
      "description": "Issue #8: an email address and a password become an unverified user.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"woman@example.com\",\n  \"password\": \"correcthorse1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/register",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "register"]
            },
            "description": "Change the email between runs — the address is unique, so replaying this request as-is gets the 409 in the next request instead."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('response has no password field', function () {",
                  "    pm.expect(pm.response.json()).to.not.have.property('password');",
                  "});",
                  "",
                  "pm.test('new user is unverified', function () {",
                  "    pm.expect(pm.response.json().email_verified).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — duplicate address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"woman@example.com\",\n  \"password\": \"correcthorse1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/register",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "register"]
            },
            "description": "Run Register once first with this same address, then run this. Refused without revealing anything about the existing user."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — weak password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"someone-else@example.com\",\n  \"password\": \"short\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/register",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "register"]
            },
            "description": "Below the 8-character floor. The response names what is wrong with it."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('response names a reason', function () {",
                  "    pm.expect(pm.response.json().detail.reasons.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
