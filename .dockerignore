# Build context hygiene. Everything here either cannot be used inside an image
# or must never travel into one.

# Secrets — infra/envs/*.env are gitignored and hold real keys.
infra/envs/*.env
!infra/envs/*.env.example
**/.env
**/.env.local

.git
.github
.venv
**/node_modules
**/.next
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

# Immutable raw fetches: large, reproducible with `make fetch`, never needed at
# runtime. build/ is deliberately NOT excluded — services/model/Dockerfile
# copies build/index, which is the one generated artefact a container needs.
raw
build/clean
build/scratch
build/tables
build/cards
build/diagrams

docs
**/tests
