# Copy to infra/envs/data.env and fill in. The real file is gitignored.
# No key, token or secret is ever committed to this repo.

# NHS Website Content API.
#
# Two different gateways exist and they are not interchangeable:
#   api.service.nhs.uk  — NHS Digital platform. Sandbox needs NO auth and returns
#                         fixed canned responses; useful for wiring a client, not
#                         for ingesting content. Header is `apikey`.
#   api.nhs.uk          — older Azure APIM gateway. Header is `subscription-key`.
#
# Ingestion needs production access on api.service.nhs.uk, which requires NHS
# Digital onboarding. That is the long-lead item — start it before the code.
NHS_BASE_URL=https://sandbox.api.service.nhs.uk/nhs-website-content
NHS_API_KEY=

# WHO ICD API — OAuth2 client credentials, used only to resolve canonical
# identifiers for conditions.yaml. Never used to fetch patient advice.
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=

# UMLS — licensed. Concept identifiers are stored; the strings never are.
UMLS_API_KEY=

# NCBI E-utilities — optional, raises the rate limit. Literature discovery only.
NCBI_API_KEY=

# Where immutable fetched content lands. One dated directory per fetch.
RAW_DIR=raw
BUILD_DIR=build
