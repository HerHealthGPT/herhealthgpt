# Copy to infra/envs/backend.env and adjust. The real file is gitignored.
# No key, token or secret is ever committed to this repo.

# The application database. The +psycopg driver marker matters: the app engine is
# async and psycopg 3 backs it. These defaults match the postgres service in
# infra/compose.yml, so `docker compose up postgres` gives a database this URL
# reaches with nothing else to configure.
HERHEALTH_DATABASE_URL=postgresql+psycopg://herhealth:herhealth@localhost:5432/herhealth

# Signs access tokens (Accounts, #9). Local-dev value only — regenerate with
# `openssl rand -hex 32` for any real deployment, and never reuse this one.
HERHEALTH_SESSION_SECRET=b549eb22ed1e65bcfcbbbff7204fa1c6f4665d684a9c9fdfac6b02c5e026322d

# Which EmailSender to use (Accounts, #10): "console" (default, logs the code
# instead of sending it — no AWS account needed) or "ses" (sends for real,
# through the identity infra/../docs/runbooks/ses-production-access.md
# provisioned — needs AWS credentials on the standard boto3 chain, region
# us-east-1). Leave unset/"console" unless you're actually testing delivery.
HERHEALTH_EMAIL_SENDER=ses

# The OAuth client this backend is registered as with Google (Accounts, #11).
# Provisioned 2026-09-01 in the "herhealthgpt" Google Cloud project — see
# docs/runbooks/google-oauth-client.md. Leaving this unset degrades
# POST /accounts/sign-in/google to a clear "not configured" 503 rather than
# the app failing to boot; that path is still exercised in the test suite.
HERHEALTH_GOOGLE_CLIENT_ID=122690235019-oabj4g0bd95eg5fnncpac6c10no38s6t.apps.googleusercontent.com

# Triage — vllm = the fine-tuned adapter on campus, with the OpenRouter base
# model as an automatic fallback when it is unreachable or cannot produce a
# valid decision (FallbackReasoningClient). openrouter = base model only.
# demo = offline scripted responses. off = disabled.
HERHEALTH_TRIAGE_MODE=vllm
OPENROUTER_API_KEY=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
HERHEALTH_MODEL_SERVICE_URL=http://127.0.0.1:8001

# Base vs Fine-tuned tabs in the chat header. OFF as of 2026-09-09: the app
# always uses the fine-tuned adapter (HERHEALTH_TRIAGE_MODE=vllm above), so
# there is nothing to choose between and the tab is hidden. Set to "on" only
# to compare the two models side by side.
HERHEALTH_MODEL_SELECTOR=off

# Campus / self-hosted vLLM via JupyterHub proxy (Lobot). Fine-tuned tab.
# JUPYTERHUB_API_TOKEN rotates when the Jupyter server restarts — refresh it.
HERHEALTH_VLLM_URL=https://lobot.cs.queensu.ca/user/group-digi2026-g1/proxy/8000
HERHEALTH_VLLM_MODEL=herhealth
HERHEALTH_VLLM_API_KEY=4f2e4b5ccdb84744b6ee9fcf8b139ceb

# Allow session cookies over http://localhost during local dev.
HERHEALTH_COOKIE_SECURE=false

# Required when the frontend calls the backend directly (NEXT_PUBLIC_API_URL=http://localhost:8000).
HERHEALTH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
