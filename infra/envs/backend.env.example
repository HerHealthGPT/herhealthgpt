# Copy to infra/envs/backend.env and adjust. The real file is gitignored.
# No key, token or secret is ever committed to this repo.

# The application database. The +psycopg driver marker matters: the app engine is
# async and psycopg 3 backs it. These defaults match the postgres service in
# infra/compose.yml, so `docker compose up postgres` gives a database this URL
# reaches with nothing else to configure.
HERHEALTH_DATABASE_URL=postgresql+psycopg://herhealth:herhealth@localhost:5432/herhealth

# Signs access tokens (Accounts, #9). Generate your own with
# `openssl rand -hex 32` — never share this value across deployments.
HERHEALTH_SESSION_SECRET=

# Which EmailSender to use (Accounts, #10): "console" (default, logs the code
# instead of sending it — no AWS account needed) or "ses" (sends for real,
# needs AWS credentials on the standard boto3 chain, region us-east-1).
HERHEALTH_EMAIL_SENDER=console

# The OAuth client this backend is registered as with Google (Accounts, #11).
# Leave unset until a Google Cloud project exists — Google sign-in degrades
# to a 503 rather than the app failing to boot.
# Also set the same Client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID in
# services/frontend/.env.local (see .env.local.example). Add
# http://localhost:3000 to Authorized JavaScript origins in Google Cloud.
HERHEALTH_GOOGLE_CLIENT_ID=

# Triage chat (issue #20 / ADR 0012).
# demo       = offline scripted responses (local MVP only).
# openrouter = OpenRouter reasoning + services/model RAG on :8001.
# vllm       = friend's GPU (HERHEALTH_VLLM_URL) with OpenRouter fallback when key set.
# off        = disable triage entirely.
HERHEALTH_TRIAGE_MODE=demo
OPENROUTER_API_KEY=
HERHEALTH_MODEL_SERVICE_URL=http://127.0.0.1:8001
HERHEALTH_VLLM_URL=http://192.168.1.42:8002
HERHEALTH_VLLM_MODEL=herhealth

# Set false for plain-HTTP local dev so browsers keep auth cookies.
HERHEALTH_COOKIE_SECURE=false

# Required if NEXT_PUBLIC_API_URL points at the backend directly (not /api).
HERHEALTH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
