# Copy to infra/envs/backend.env and adjust. The real file is gitignored.
# No key, token or secret is ever committed to this repo.

# The application database. The +psycopg driver marker matters: the app engine is
# async and psycopg 3 backs it. These defaults match the postgres service in
# infra/compose.yml, so `docker compose up postgres` gives a database this URL
# reaches with nothing else to configure.
HERHEALTH_DATABASE_URL=postgresql+psycopg://herhealth:herhealth@localhost:5432/herhealth

# Signs access tokens (Accounts, #9). Generate your own with
# `openssl rand -hex 32` — never share this value across deployments.
HERHEALTH_SESSION_SECRET=
