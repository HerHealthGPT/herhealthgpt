# Immutable fetched source content and generated artefacts.
# Both are reproducible from `make fetch build`; neither belongs in git.
raw/
# Build artefacts
build/
services/backend/var/

# Secrets. infra/envs/*.env.example is tracked; the real .env files are not.
.env
*.env
!*.env.example
# Editor/CLI backups. `*.env` above does NOT match `backend.env.bak`, which is
# how a real OPENROUTER_API_KEY, SESSION_SECRET, VLLM token and database URL
# reached main in 9f58945 (2026-09-17) and stayed there. Keep both lines.
*.bak
*.env.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

docs/submissions/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

# Terraform. The lock file (.terraform.lock.hcl) IS committed; local state,
# plan files and provider caches are not. The bootstrap stack's state is local
# by design (infra/terraform/bootstrap/main.tf).
.terraform/
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Variable files carry real values (alert address, checksums). Examples are tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Adding the Fine-tuned model files to .gitignore
# Fine-tuned model files are large and can be regenerated from the training data and scripts.
herhealth-lora-v2/

#Adding graphify generated files to .gitignore
# Graphify generated files are large and can be regenerated from the source data and scripts.
graphify-out/cache/
# Per-machine sidecars: absolute interpreter and scan-root paths, and scratch
# files from an interrupted run. They differ on every machine, so tracking them
# makes every graphify run show as a change. The shared outputs (GRAPH_REPORT.md,
# graph.json, graph.html, manifest.json, cost.json) and the community labels stay
# tracked.
graphify-out/.graphify_*
!graphify-out/.graphify_labels.json
graphify-out/.needs_update

# graphify's own backup of the previous graph, one folder per day.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
